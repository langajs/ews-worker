      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\n\nconst taskId = body.task_id;\nconst subTaskId = body.sub_task_id;\nconst setIndex = parseInt(body.set_index) || 0;\nconst referenceImage = body.reference_image || '';\nconst imageType = body.image_type;\nconst imagePosition = parseInt(body.image_position) || 1;\nconst callbackSecret = body.callback_secret || '';\nconst callbackUrl = body.callback_url || '';\nconst userDescription = String(body.main_description || '').trim();\nlet auxiliaryImages = [];\ntry {\n  auxiliaryImages = Array.isArray(body.auxiliary_images)\n    ? body.auxiliary_images\n    : JSON.parse(body.auxiliary_images || '[]');\n} catch (_) {}\n\nconst finalPrompt = [\n  '生成一张国内电商商品主图。',\n  '主体居中完整，构图有视觉重点，适合作为国内电商首图。',\n  '必须严格保持商品品类、结构、包装、商标、材质和已有文字一致，不虚构功能。',\n  '画面清晰真实，不生成价格、水印、边框或无关商品。',\n  '图片位置：' + imagePosition + '。',\n  userDescription ? '用户要求：' + userDescription : '',\n].filter(Boolean).join('\\n');\n\nconst imagesArray = [referenceImage, ...auxiliaryImages].filter(Boolean);\nreturn {\n  taskId, subTaskId, setIndex, referenceImage, imageType, imagePosition,\n  finalPrompt, imagesArray, callbackSecret, callbackUrl,\n};"
        },
