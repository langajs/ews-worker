          "method": "POST",
          "url": "https://api.deepseek.com/chat/completions",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是一位专业的电商标题撰写师。根据参考标题和数量要求，生成符合国内电商平台（天猫、淘宝、拼多多）风格的商品标题。必须严格按照格式要求输出，只返回 JSON 数组。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"请根据要求生成 {{ $json.subTaskCount }} 个不同的商品标题：\\n\\n参考标题：\\n{{ $json.referenceTitle }}\\n\\n商品描述：{{ $json.description }}\\n\\n要求：\\n1. 每个标题不超过60个字符(每个汉字算2个字符)\\n2. 标题要包含核心关键词，突出卖点\\n3. 同一批次的标题要有差异化\\n4. 符合国内电商搜索习惯\\n5. 仅返回一个 JSON 数组，数组元素为字符串，每个字符串是一个标题。格式示例：[\\\"标题1\\\", \\\"标题2\\\", ...]。不要包含序号、说明或其他任何额外文本。\"\n    }\n  ],\n  \"stream\": false\n}",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          288,
          -32
        ],
