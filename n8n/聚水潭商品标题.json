      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst content = String(response?.choices?.[0]?.message?.content || '')\n  .replace(/```json\\s*/gi, '')\n  .replace(/```/g, '')\n  .trim();\nconst original = $node['提取参数'].json;\n\nlet generated = [];\ntry {\n  const parsed = JSON.parse(content);\n  if (Array.isArray(parsed)) generated = parsed;\n} catch (_) {}\n\nconst titles = Array.from({ length: original.subTaskCount }, (_, index) => {\n  const value = String(generated[index] || '').trim() || original.referenceTitle;\n  return Array.from(value).slice(0, 100).join('');\n});\n\nreturn {\n  callback_secret: original.callbackSecret,\n  task_id: original.taskId,\n  titles,\n  callbackUrl: original.callbackUrl,\n};"
        },
        "type": "n8n-nodes-base.code",
