      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\n\nconst taskId = String(body.task_id || '').trim();\nconst referenceTitle = String(body.reference_title || '').trim();\nconst description = String(body.description || '').trim();\nconst subTaskCount = parseInt(body.sub_task_count) || 1;\nconst callbackSecret = String(body.callback_secret || '');\nconst callbackUrl = String(body.callback_url || '').trim();\n\nif (!taskId || !referenceTitle || !callbackUrl || subTaskCount < 1) {\n  throw new Error('商品标题任务参数不完整');\n}\n\nreturn { taskId, referenceTitle, description, subTaskCount, callbackSecret, callbackUrl };"
        },
