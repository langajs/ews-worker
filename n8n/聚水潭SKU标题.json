        "webhookId": "d623bbeb-3097-44eb-95ad-4bd3bacb0b54"
      },
      {
        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\n\nconst taskId = String(body.task_id || '').trim();\nconst referenceTitle = String(body.reference_title || '').trim();\nconst description = String(body.description || '').trim();\nconst productType = String(body.product_type || 'one');\nconst subTaskCount = parseInt(body.sub_task_count) || 1;\nconst variants = Array.isArray(body.variants) ? body.variants : [];\nconst callbackSecret = String(body.callback_secret || '');\nconst callbackUrl = String(body.callback_url || '').trim();\n\nif (!taskId || !callbackUrl || variants.length === 0 || subTaskCount < 1) {\n  throw new Error('SKU标题任务参数不完整');\n}\n\nconst variantLabels = variants.map(variant => [variant.name, variant.option2]\n  .map(value => String(value || '').trim())\n  .filter(Boolean)\n  .join(' / '));\nif (variantLabels.some(label => !label)) throw new Error('SKU规格组合不能为空');\n\nconst variantDescMap = variants.map((variant, index) => {\n  const detail = String(variant.sku_description || '').trim() || '无额外描述';\n  return variantLabels[index] + '：' + detail;\n}).join('；');\n\nreturn {\n  taskId,\n  referenceTitle,\n  description,\n  productType,\n  subTaskCount,\n  variantCount: variants.length,\n  totalCount: subTaskCount * variants.length,\n  variantLabels,\n  variantDescMap,\n  callbackSecret,\n  callbackUrl,\n};"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          448,
          0
        ],
        "id": "7072d127-a988-4675-be01-9c14b974cadc",
        "name": "提取数据"
      },
      {
        "parameters": {
          "method": "POST",
          "url": "https://api.deepseek.com/chat/completions",
          "authentication": "genericCredentialType",
          "genericAuthType": "httpHeaderAuth",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={\n  \"model\": \"deepseek-v4-flash\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"你是专业的国内电商 SKU 标题撰写师。根据商品资料和完整规格组合，为每套商品的每个 SKU 生成简洁标题。必须保留对应的完整规格组合，严格按输入顺序输出 JSON 字符串数组。\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"参考标题：{{ $json.referenceTitle }}\\n商品描述：{{ $json.description }}\\n商品结构：{{ $json.productType }}\\n规格组合：{{ $json.variantDescMap }}\\n\\n共 {{ $json.subTaskCount }} 套，每套 {{ $json.variantCount }} 个 SKU，总计 {{ $json.totalCount }} 个标题。要求：1. 每个标题以对应完整规格组合开头；2. 可追加简短卖点，不改变规格值；3. 每套之间可差异化；4. 按先套图、后规格组合的顺序输出；5. 仅返回 JSON 字符串数组，不要 Markdown、序号或说明。\"\n    }\n  ],\n  \"stream\": false\n}",
          "options": {}
        },
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.4,
        "position": [
          672,
          0
        ],
        "id": "fce74099-a0f9-402a-a795-40305cca5918",
        "name": "deepseek-v4-flash",
        "credentials": {
          "httpHeaderAuth": {
            "id": "11xE3AjgQ1iUHDdR",
            "name": "deepseek"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "const response = $input.first().json;\nconst content = String(response?.choices?.[0]?.message?.content || '')\n  .replace(/```json\\s*/gi, '')\n  .replace(/```/g, '')\n  .trim();\nconst original = $node['提取数据'].json;\n\nlet generated = [];\ntry {\n  const parsed = JSON.parse(content);\n  if (Array.isArray(parsed)) generated = parsed;\n} catch (_) {}\n\nconst skuTitles = Array.from({ length: original.totalCount }, (_, index) => {\n  const label = original.variantLabels[index % original.variantCount];\n  let value = String(generated[index] || '').trim();\n  if (!value) value = label + ' 精选';\n  if (!value.startsWith(label)) value = label + ' ' + value;\n  return Array.from(value).slice(0, 30).join('');\n});\n\nreturn {\n  callback_secret: original.callbackSecret,\n  task_id: original.taskId,\n  sku_titles: skuTitles,\n  callbackUrl: original.callbackUrl,\n};"
        },
