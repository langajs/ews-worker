        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\n\nconst taskId = body.task_id;\nconst subTaskId = body.sub_task_id;\nconst setIndex = parseInt(body.set_index) || 0;\nconst skuDescription = String(body.sku_description || '').trim();\nconst skuImage = body.sku_image || '';\nconst imageType = body.image_type;\nconst imagePosition = parseInt(body.image_position) || 1;\nconst callbackSecret = body.callback_secret || '';\nconst callbackUrl = body.callback_url || '';\n\nconst defaultPrompt = [\n  '基于当前 SKU 参考图生成一张 1:1 电商规格图，主体清晰完整。',\n  '严格保持参考图中的产品品类、数量、结构、包装、商标、文字、颜色、材质和配件一致。',\n  '使用干净、明亮、真实的商业摄影背景，主体居中，不裁切商品。',\n  '不得擅自增减商品数量，不得新增促销文案、价格、水印、边框、拼图或无关配件。',\n].join('\\n');\nconst finalPrompt = skuDescription || defaultPrompt;\nconst imagesArray = [skuImage].filter(Boolean);\n\nreturn {\n  taskId, subTaskId, setIndex, skuDescription, skuImage,\n  imageType, imagePosition, finalPrompt, imagesArray, callbackSecret, callbackUrl,\n};"
        },
