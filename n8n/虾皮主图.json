        "parameters": {
          "jsCode": "const body = $input.first().json.body || {};\n\nconst taskId = body.task_id;\nconst subTaskId = body.sub_task_id;\nconst setIndex = body.set_index;\nconst referenceImage = body.reference_image;\nconst imageType = body.image_type;\nconst imagePosition = body.image_position;\nconst callbackSecret = body.callback_secret || '';\nconst callbackUrl = body.callback_url;\n\nconst mainDescription = body.main_description || '';\nconst detailDescription = body.detail_description || '';\nconst userPrompt = imageType === 'main' ? mainDescription : detailDescription;\n\n// ============================================================\n// 系统提示词编辑区(当前版本越南测试版本,暂不开放用户提示词)\n// ============================================================\nconst systemPrompt = '你是一个视觉产品设计，产品视觉效果：空间立体 视觉广角从下网上的广角 3D建模效果,目标市场:越南,所有的卖点词、文字、营销文案等全部使用越南语（要真实,严格保持产品一致性,不要出现变形,风格可以偏海报一点，突出半价优惠,注意不要出现价格,标注前一百名有额外赠品），产品的**包装**、**包装上的文字**、**图片**、**细节**等，不可以做任何修改。';\n// ============================================================\n\nconst finalPrompt = systemPrompt;// + ' ' + userPrompt;\n\nlet auxiliaryImages = [];\ntry {\n  auxiliaryImages = JSON.parse(body.auxiliary_images || '[]');\n} catch(e) {\n  auxiliaryImages = [];\n}\n\nconst imagesArray = [referenceImage, ...auxiliaryImages].filter(Boolean);\n\nconst subTasks = body.sub_tasks || [];\nlet currentSubTask = subTasks.find(st => st.sub_task_id === subTaskId) || {};\nconst styleCode = currentSubTask.style_code || '';\n\nreturn {\n  taskId,\n  subTaskId,\n  setIndex,\n  referenceImage,\n  imageType,\n  imagePosition,\n  finalPrompt,\n  imagesArray,\n  styleCode,\n  callbackSecret,\n  callbackUrl,\n  attempts: 0\n};"
