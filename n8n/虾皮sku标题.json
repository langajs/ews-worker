                  {
                      "parameters":  {
                                         "jsCode":  "const response = $input.first().json;\nconst originalData = $node[\u0027提取数据\u0027].json;\nlet content = response?.choices?.[0]?.message?.content;\n\nif (typeof content !== \u0027string\u0027) {\n  throw new Error(\u0027模型未返回 SKU 标题\u0027);\n}\ncontent = content.replace(/```json\\s*/gi, \u0027\u0027).replace(/```/g, \u0027\u0027).trim();\n\nlet titles;\ntry {\n  titles = JSON.parse(content);\n} catch (error) {\n  throw new Error(\u0027SKU 标题结果不是合法 JSON 数组\u0027);\n}\nif (!Array.isArray(titles) || titles.length !== originalData.totalCount) {\n  throw new Error(`SKU 标题数量不匹配: ${Array.isArray(titles) ? titles.length : 0} / ${originalData.totalCount}`);\n}\n\ntitles = titles.map((value, index) =\u003e {\n  const title = typeof value === \u0027string\u0027 ? value.replace(/\\s+/g, \u0027 \u0027).trim() : \u0027\u0027;\n  if (title.length \u003c 1 || title.length \u003e 20) {\n    throw new Error(`SKU 标题#${index + 1}长度必须为1~20字符`);\n  }\n  return title;\n});\n\nreturn {\n  callback_secret: originalData.callbackSecret,\n  task_id: originalData.taskId,\n  sku_titles: titles,\n  callbackUrl: originalData.callbackUrl\n};"
                                     },
