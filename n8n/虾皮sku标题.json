                  {
                      "parameters":  {
                                         "jsCode":  "const body = $input.first().json.body || {};\n\nconst taskId = body.task_id;\nconst name = String(body.name || \u0027\u0027).trim();\nconst referenceTitle = String(body.reference_title || \u0027\u0027).trim();\nconst description = String(body.description || \u0027\u0027).trim();\nconst subTaskCount = Math.max(parseInt(body.sub_task_count) || 1, 1);\nconst callbackSecret = body.callback_secret || \u0027\u0027;\nconst callbackUrl = body.callback_url || \u0027\u0027;\nlet variants = body.variants;\n\nif (typeof variants === \u0027string\u0027) {\n  try { variants = JSON.parse(variants); } catch (error) { variants = []; }\n}\nif (!taskId || !callbackUrl || !Array.isArray(variants) || variants.length === 0) {\n  throw new Error(\u0027缺少 task_id、callback_url 或 variants\u0027);\n}\n\nconst normalizedVariants = variants.map((variant, index) =\u003e ({\n  index: index + 1,\n  name: String(variant?.name || \u0027\u0027).trim(),\n  option2: String(variant?.option2 || \u0027\u0027).trim()\n}));\nif (normalizedVariants.some(variant =\u003e !variant.name)) {\n  throw new Error(\u0027变体名称不能为空\u0027);\n}\n\nconst variantCount = normalizedVariants.length;\nconst totalCount = subTaskCount * variantCount;\nconst finalPrompt = `\n你是 Shopee 越南站规格值生成专家。请为每套商品的每个变体生成“Option for Variation 1”文案。\n\n商品名称：${name}\n参考标题：${referenceTitle}\n商品描述：${description}\n子任务数量：${subTaskCount}\n每套变体：${JSON.stringify(normalizedVariants)}\n\n要求：\n1. 输出自然、明确的越南语规格值，准确保留原变体的颜色、款式、尺寸或材质语义。\n2. 二级规格 option2 已由表格单独填写，不要重复拼接到一级规格中。\n3. 每个规格值长度必须为 1~20 个字符，不加序号、营销词、价格、括号或解释。\n4. 输出顺序严格为：第1套全部变体、第2套全部变体，依此类推；每套内部保持输入 variants 顺序。\n5. 共输出 ${totalCount} 项。只返回严格 JSON 字符串数组，不要 Markdown。\n`;\n\nreturn {\n  taskId,\n  subTaskCount,\n  variantCount,\n  totalCount,\n  finalPrompt,\n  callbackSecret,\n  callbackUrl\n};"
                                     },
