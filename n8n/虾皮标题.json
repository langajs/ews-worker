                      "parameters":  {
                                         "jsCode":  "const response = $input.first().json;\nconst originalData = $node[\u0027提取参数\u0027].json;\nlet content = response?.choices?.[0]?.message?.content;\n\nif (typeof content !== \u0027string\u0027) {\n  throw new Error(\u0027模型未返回标题文本\u0027);\n}\n\ncontent = content.replace(/```json\\s*/gi, \u0027\u0027).replace(/```/g, \u0027\u0027).trim();\nlet titles;\ntry {\n  titles = JSON.parse(content);\n} catch (error) {\n  throw new Error(\u0027标题结果不是合法 JSON 数组\u0027);\n}\n\nif (!Array.isArray(titles) || titles.length !== originalData.subTaskCount) {\n  throw new Error(`标题数量不匹配: ${Array.isArray(titles) ? titles.length : 0} / ${originalData.subTaskCount}`);\n}\n\ntitles = titles.map((value, index) =\u003e {\n  const title = typeof value === \u0027string\u0027 ? value.replace(/\\s+/g, \u0027 \u0027).trim() : \u0027\u0027;\n  if (title.length \u003c 10 || title.length \u003e 120) {\n    throw new Error(`标题#${index + 1}长度必须为10~120字符`);\n  }\n  return title;\n});\n\nif (new Set(titles.map(title =\u003e title.toLocaleLowerCase(\u0027vi\u0027))).size !== titles.length) {\n  throw new Error(\u0027标题结果存在重复项\u0027);\n}\n\nreturn {\n  callback_secret: originalData.callbackSecret,\n  task_id: originalData.taskId,\n  titles,\n  callbackUrl: originalData.callbackUrl\n};"
                                     },
